{
  "manifest_version": 3,
  "name": "HUST GPA/CPA Calculator",
  "version": "1.2.0",
  "description": "Tự động đọc bảng điểm cá nhân trên QLĐT HUST và tính GPA/CPA.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "HUST GPA/CPA Calculator"
  },
  "permissions": [],
  "host_permissions": [
    "https://qldt.hust.edu.vn/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://qldt.hust.edu.vn/students/learn/personal-transcript*"],
      "js": ["libs/xlsx.full.min.js", "libs/jspdf.umd.min.js", "libs/jspdf.plugin.autotable.min.js", "libs/notosans-vn-font.js", "content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
